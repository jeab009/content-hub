# Copy to .env (repo root, same directory as docker-compose.yml) before
# running `docker compose up`. This file is read by docker-compose.yml for
# variable substitution AND passed into the backend container's environment.
#
# Never commit the real .env — it's already gitignored.

# --- Postgres (used by the postgres service and to build DATABASE_URL) ---
POSTGRES_USER=content_hub
POSTGRES_PASSWORD=content_hub
POSTGRES_DB=content_hub

# --- Sessions ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-64-char-hex-string

# --- Token encryption (AES-256-GCM), exactly 32 bytes base64-encoded ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# --- Facebook OAuth (Meta Graph API) ---
# Both are required by backend/src/config/env.validation.ts — the backend
# refuses to boot if either is empty. The placeholders below let the stack
# boot and let you exercise login/settings; the "Connect a Facebook Page"
# button itself will fail against Meta until you replace these with real
# values from a Meta App dashboard — see docs/meta-app-review-status.md.
FACEBOOK_APP_ID=demo-app-id-replace-me
FACEBOOK_APP_SECRET=demo-app-secret-replace-me

# --- Seed admin ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Content Hub Admin
# Leave blank to have the seed script generate and print a random password
# once on first backend container start (see backend/prisma/seed.ts).
SEED_ADMIN_PASSWORD=
