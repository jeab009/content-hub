# Copy to .env (repo root, same directory as docker-compose.yml) before
# running `docker compose up`. This file is read by docker-compose.yml for
# variable substitution AND passed into the backend container's environment.
#
# Never commit the real .env — it's already gitignored.

# --- Postgres (used by the postgres service and to build DATABASE_URL) ---
POSTGRES_USER=content_hub
POSTGRES_PASSWORD=content_hub
POSTGRES_DB=content_hub

# --- Sessions ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-64-char-hex-string

# --- Token encryption (AES-256-GCM), exactly 32 bytes base64-encoded ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# --- Facebook OAuth (Meta Graph API) ---
# Both are required by backend/src/config/env.validation.ts — the backend
# refuses to boot if either is empty. The placeholders below let the stack
# boot and let you exercise login/settings; the "Connect a Facebook Page"
# button itself will fail against Meta until you replace these with real
# values from a Meta App dashboard — see docs/meta-app-review-status.md.
FACEBOOK_APP_ID=demo-app-id-replace-me
FACEBOOK_APP_SECRET=demo-app-secret-replace-me

# --- Google OAuth (YouTube Data API) ---
# Optional, unlike the Facebook pair above: the backend boots fine with these
# blank and the "Connect a YouTube Channel" button returns a clear 409 "not
# configured" until they are set. Get them from a Google Cloud OAuth client
# (Web application type) with the YouTube Data API v3 enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Host URLs (only needed when NOT running on localhost) ---
# These four describe the same two origins as the browser sees them, so they
# change together when deploying to a real host. Leave them unset for local
# development — docker-compose.yml already defaults every one to localhost.
#
# NEXT_PUBLIC_API_BASE_URL is inlined by Next.js at BUILD time, so changing it
# needs `docker compose build frontend`, not just a restart.
#
# Each redirect URI must also be registered verbatim in the corresponding
# provider console (Meta App dashboard / Google Cloud credentials).
#
# NODE_ENV=production enables the session cookie's Secure flag and therefore
# REQUIRES HTTPS — leave it as development on a plain-HTTP host or login breaks.
# NODE_ENV=production
# CORS_ORIGIN=https://your-frontend-domain
# NEXT_PUBLIC_API_BASE_URL=https://your-api-domain
# FACEBOOK_REDIRECT_URI=https://your-api-domain/api/connected-accounts/facebook/callback
# GOOGLE_REDIRECT_URI=https://your-api-domain/api/connected-accounts/google/callback

# --- Seed admin ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Content Hub Admin
# Leave blank to have the seed script generate and print a random password
# once on first backend container start (see backend/prisma/seed.ts).
SEED_ADMIN_PASSWORD=
