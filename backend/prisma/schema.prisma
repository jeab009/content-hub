// Content Hub — Phase 1 database schema
//
// IMPORTANT (System Analyst security decision #9): Prisma enum migrations must
// be treated as ADDITIVE-ONLY. Never remove or reorder existing enum values in
// a migration — Postgres enum value removal/reorder is destructive and cannot
// be safely rolled back once rows reference the value. Only ever append new
// values. This is a process rule (not enforceable by Prisma itself), documented
// here and in docs/security-decisions.md.
//
// IMPORTANT (System Analyst security decision #5): raw SQL escape hatches
// ($queryRawUnsafe / $executeRawUnsafe) are BANNED across this codebase. Only
// Prisma's parameterized query builder (or $queryRaw / $executeRaw with
// tagged-template parameter binding, used only where Prisma's query builder
// truly cannot express the query — e.g. the CHECK constraint below, which is
// DDL added by hand in a migration file, not a runtime query) may be used.
// See .eslintrc.cjs `no-restricted-properties` rule.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
}

// ⚠ Phase 6: `shopee` / `tiktok_shop` were deliberately NOT added here. See
// the warning block on `AssetPlatform` below and phase6-project-plan.md
// Decision 2. Frozen by src/testing/separation/enum-freeze.spec.ts.
enum Platform {
  facebook
  youtube
  tiktok
  line
}

enum ConnectedAccountStatus {
  connected
  disconnected
  expired
  revoked
}

enum ContentType {
  video
  image
  text
}

enum ContentStatus {
  draft
  ready
  archived
}

enum LicensingStatus {
  unlicensed
  pending_review
  licensed
  exempt
}

enum PostStatus {
  draft
  scheduled
  posted
  failed
  cancelled
  posted_unconfirmed // Phase 2 addition, appended per the additive-only enum rule above. See docs/publish-orchestration-addendum.md.
}

enum MetricSource {
  api
  manual
}

// Phase 5.0: how a post reached the platform. `adapter` = published through a
// PlatformAdapter by this system (FB/YT, and TikTok/LINE in mock mode);
// `manual_external` = the admin published natively on the platform and then
// recorded the resulting external id/URL here (the delivered TikTok/LINE path,
// see docs/phase5-project-plan.md Decision 1). Default `adapter` so every
// legacy row stays valid without a backfill.
enum PublishMethod {
  adapter
  manual_external
}

enum Sentiment {
  positive
  negative
  neutral
}

// --- Phase 1.5 additions (Compliance & Schema Gate) ---------------------
// See docs/security-decisions.md / System Analyst Phase 1.5 approval for
// the full rationale. These enums/models are schema-only in this
// iteration: no controller, no publish-flow wiring yet (Phase 2+).

enum ContentPillar {
  product
  drama
  comedy
}

// DB enum labels use the literal age-band strings from the business rule
// doc (e.g. "18-22"), which aren't valid bare Prisma identifiers (leading
// digit, hyphen), hence the @map on each value.
enum TargetAgeSegment {
  age_18_22   @map("18-22")
  age_23_30   @map("23-30")
  age_31_45   @map("31-45")
  age_46_plus @map("46+")
}

// Deliberately not a boolean (System Analyst Condition #3): "blocked" must
// be distinguishable from "not yet reviewed" so a blocked item can never be
// confused with one that simply hasn't been checked yet.
enum CopyrightClearance {
  not_checked
  cleared
  blocked
}

// Separate from the existing `Platform` enum (which is Phase 1's
// connected-account/post/metric/comment platform set and, per the
// additive-only enum rule at the top of this file, must never be renamed).
// The Analyst's Phase 1.5 spec names this platform "line_oa" specifically
// (LINE Official Account) rather than reusing Phase 1's generic "line" —
// kept as its own enum so the two concerns don't get conflated and Phase 1
// data is untouched.
//
// ⚠ STOP — READ BEFORE ADDING A VALUE HERE (Phase 6, risk R4).
// This enum is THE RANKING DOMAIN, not a labelling enum.
// `ranking-v2.constants.ts` sets
//     RANKED_PLATFORMS_V2 = PLATFORM_TIE_BREAK_ORDER   (readonly AssetPlatform[])
// so appending a value here ENROLS IT INTO v2 SCORING on the spot — with no
// code change, no review, and no failing test. Phase 6 deliberately did NOT
// add `shopee` here for exactly this reason: commerce/affiliate is a
// structurally separate stream and the ranking engine does not consume
// commerce signal (phase6-project-plan.md C-C, Decision 2). Commerce uses the
// parallel `CommerceChannel` enum instead.
// Enum additions are IRREVERSIBLE per the header rule at the top of this
// file, so this mistake would be permanent. A value added here also demands a
// platform_cadence_targets row, a pillar_ratio_policies position, a scheduler
// cadence card, and a platform-map.util counterpart.
// The freeze test at src/testing/separation/enum-freeze.spec.ts fails if this
// enum changes.
//
// ⚠ Phase 7 (paid/ads visibility): the identical argument applies to `meta`.
// Do NOT add `meta` / `meta_ads` here — it would enrol paid campaign data into
// v2 scoring exactly as `shopee` would have. Paid/ads uses its own parallel
// `AdChannel` enum instead (phase7-project-plan.md Decision 3/4,
// phase7-system-analyst-signoff.md §2 Layer 1/SA-P-B). Frozen by the same
// enum-freeze test, extended with an `AdChannel` assertion.
enum AssetPlatform {
  facebook
  youtube
  tiktok
  line_oa
}

// DB enum labels are the literal ratio strings ("1:1" etc.), not valid bare
// identifiers, hence @map on each value.
enum AspectRatio {
  ratio_1_1  @map("1:1")
  ratio_4_5  @map("4:5")
  ratio_9_16 @map("9:16")
  ratio_16_9 @map("16:9")
}

enum CadencePeriodUnit {
  week
  month
}

// Phase 2 Pass B addition. Version of the ranking engine that produced a
// RankingScore row. v1 is the explainable rule-based engine
// (RankingEngineService); v2 is reserved for a future learned/refined
// engine so historical scores stay attributable to the logic that made
// them. Additive-only, like every enum in this file.
enum EngineVersion {
  v1
  v2
}

// --- Phase 4 additions (Comment Aggregation) ----------------------------
// Additive-only per the header rule. See docs/phase4-architecture-design.md
// §1 and docs/phase4-system-analysis.md (conditions C1–C10).

// Rule-based triage class (a separate concern from Sentiment). `general` is
// the safe default for anything the triage rules don't positively classify —
// the same "honest neutral default" reasoning as copyright_cleared=not_checked.
enum CommentPriority {
  complaint
  question
  spam
  general
}

// Which classifier produced Comment.sentiment. Mirrors MetricSource(api/manual)
// so re-classification is auditable: a row tagged `rule_based` today can be
// re-tagged `model` later and the provenance is never lost.
enum SentimentSource {
  rule_based
  model
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String
  email               String    @unique
  passwordHash        String    @map("password_hash")
  role                UserRole  @default(admin)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  connectedAccounts ConnectedAccount[]
  contents          Content[]              @relation("ContentCreatedBy")
  executedPosts     Post[]                 @relation("PostExecutedBy")
  // Phase 4 additions (back-relations for comment reply attribution + templates).
  repliedComments   Comment[]              @relation("CommentRepliedBy")
  commentTemplates  CommentReplyTemplate[]

  @@map("users")
}

model ConnectedAccount {
  id                    String                 @id @default(uuid()) @db.Uuid
  userId                String                 @map("user_id") @db.Uuid
  platform              Platform
  platformAccountId     String                 @map("platform_account_id")
  platformAccountName   String                 @map("platform_account_name")
  // Nullable by deviation from the literal spec ("text", not marked nullable):
  // the mandatory security fix "DELETE /connected-accounts/:id ... overwrite
  // encrypted token columns to null" requires this column to accept NULL.
  // See docs/security-decisions.md for the reasoning.
  accessTokenEncrypted  String?                @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String?                @map("refresh_token_encrypted") @db.Text
  tokenExpiresAt        DateTime               @map("token_expires_at")
  scopes                String[]
  status                ConnectedAccountStatus @default(connected)
  connectedAt           DateTime               @default(now()) @map("connected_at")
  disconnectedAt        DateTime?              @map("disconnected_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, platform, platformAccountId])
  @@index([status])
  @@map("connected_accounts")
}

model Content {
  id                   String             @id @default(uuid()) @db.Uuid
  type                 ContentType
  title                String
  mediaUrl             String             @map("media_url")
  caption              String?
  targetAgeMin         Int                @map("target_age_min")
  targetAgeMax         Int                @map("target_age_max")
  status               ContentStatus      @default(draft)
  licensingStatus      LicensingStatus    @default(unlicensed) @map("licensing_status")
  licenseNotes         String?            @map("license_notes")
  licenseExpiresAt     DateTime?          @map("license_expires_at") @db.Date
  // Phase 2 additions (upload metadata) — nullable: Phase 1 rows and any
  // future text-only content have no uploaded file to describe.
  fileSizeBytes        BigInt?            @map("file_size_bytes")
  mimeType             String?            @map("mime_type")
  // Phase 1.5 additions (Compliance & Schema Gate) ------------------------
  // `contentPillar` is nullable: unlike `copyrightCleared` (which has an
  // honest "not yet reviewed" state to default to), there is no neutral
  // value among product/drama/comedy that would accurately describe
  // existing/legacy content. Rather than fabricate one, this stays
  // unclassified (null) until an admin assigns it. The copyright-gate
  // service (see copyright-gate.service.ts) treats null the same as a
  // risk-bearing pillar — fail closed, evidence required — so leaving this
  // unset can never widen what's allowed to be marked cleared.
  contentPillar        ContentPillar?     @map("content_pillar")
  // Nullable, intentionally unused this iteration — sub-segment targeting
  // is still an open business decision (see bussiness_rule.md "Target
  // Audience"). Column exists now so it doesn't require another migration
  // once that decision lands.
  targetAgeSegment     TargetAgeSegment?  @map("target_age_segment")
  copyrightCleared     CopyrightClearance @default(not_checked) @map("copyright_cleared")
  copyrightNotes       String?            @map("copyright_notes")
  // Required (by the copyright-gate service, not a DB constraint) for
  // drama/product pillar content before copyrightCleared may become
  // `cleared` — System Analyst Condition #3.
  copyrightEvidenceUrl String?            @map("copyright_evidence_url")
  createdBy            String             @map("created_by") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  creator       User           @relation("ContentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  posts         Post[]
  assets        ContentAsset[]
  rankingScores RankingScore[]

  @@index([status, createdBy, licensingStatus])
  @@map("contents")
}

// Phase 1.5 addition. One row per platform-specific render/crop of a piece
// of Content (e.g. a 9:16 TikTok cut vs. a 1:1 Facebook feed cut of the
// same source). Schema-only this iteration — nothing writes to this table
// yet (Phase 2 CMS asset pipeline will).
model ContentAsset {
  id              String        @id @default(uuid()) @db.Uuid
  contentId       String        @map("content_id") @db.Uuid
  platform        AssetPlatform
  aspectRatio     AspectRatio   @map("aspect_ratio")
  mediaUrl        String        @map("media_url")
  // Phase 6 addition (additive, nullable). Duration is a genuine property of
  // any video asset, not a Shopee-specific hack — but it is the property the
  // Shopee 10–60s placement rule reads. Nullable with no backfill: every
  // legacy row stays valid, and a best-effort MP4 parse that fails must leave
  // NULL rather than guess. NULL is a rejection at the placement gate, never
  // a pass (see commerce_placements_shopee_duration_chk).
  durationSeconds Int?          @map("duration_seconds")
  createdAt       DateTime      @default(now()) @map("created_at")

  content Content @relation(fields: [contentId], references: [id], onDelete: Restrict)

  @@index([contentId])
  @@map("content_assets")
}

// Phase 1.5 addition. Admin-configurable target split of content pillars.
// Seeded with an explicitly-provisional placeholder split (see
// prisma/seed.ts) pending a real admin decision — nothing reads this table
// yet (Phase 3 ranking engine will).
model PillarRatioPolicy {
  id             String        @id @default(uuid()) @db.Uuid
  contentPillar  ContentPillar @map("content_pillar")
  targetRatioPct Decimal       @map("target_ratio_pct") @db.Decimal(5, 2)
  effectiveFrom  DateTime      @map("effective_from") @db.Date
  isProvisional  Boolean       @default(true) @map("is_provisional")
  createdByNote  String?       @map("created_by_note")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("pillar_ratio_policies")
}

// Phase 1.5 addition. Admin-configurable per-platform posting cadence
// target. Seeded with placeholder values (see prisma/seed.ts) pending a
// real admin decision — nothing reads this table yet (Phase 3 ranking
// engine will).
model PlatformCadenceTarget {
  id                   String            @id @default(uuid()) @db.Uuid
  platform             AssetPlatform
  targetPostsPerPeriod Int               @map("target_posts_per_period")
  periodUnit           CadencePeriodUnit @map("period_unit")
  effectiveFrom        DateTime          @map("effective_from") @db.Date
  isProvisional        Boolean           @default(true) @map("is_provisional")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@map("platform_cadence_targets")
}

model Post {
  id                  String         @id @default(uuid()) @db.Uuid
  contentId           String         @map("content_id") @db.Uuid
  platform            Platform
  priorityScore       Decimal?       @map("priority_score") @db.Decimal(10, 4)
  recommendedAt       DateTime?      @map("recommended_at")
  scheduledAt         DateTime?      @map("scheduled_at")
  postedAt            DateTime?      @map("posted_at")
  status              PostStatus     @default(draft)
  executedBy          String?        @map("executed_by") @db.Uuid
  externalPostId      String?        @map("external_post_id")
  // Phase 2 addition: optimistic-concurrency guard for the publish
  // orchestrator's conditional UPDATEs. See docs/publish-orchestration-addendum.md §2.
  version             Int            @default(0)
  // Phase 5.0 additions (manual-external-record path). `externalPostUrl` is
  // the human-verifiable permalink the admin pasted when recording a natively
  // published post — nullable because adapter publishes don't produce one.
  // `publishMethod` distinguishes adapter-published from manually-recorded
  // rows for audit/analytics; defaults to `adapter` so legacy rows are valid.
  externalPostUrl     String?        @map("external_post_url")
  publishMethod       PublishMethod  @default(adapter) @map("publish_method")
  // Phase 2 Pass B additions (ranking-informed publish). All nullable
  // because legacy Phase 1 rows predate the ranking engine.
  // `recommendedPlatform` / `wasOverride` are ALWAYS recomputed server-side
  // from the latest ranking_scores at publish time — never accepted from
  // the client (System Analyst hard constraint).
  recommendedPlatform AssetPlatform? @map("recommended_platform")
  selectedPlatform    AssetPlatform? @map("selected_platform")
  wasOverride         Boolean        @default(false) @map("was_override")
  overrideReason      String?        @map("override_reason")
  rankingScoreId      String?        @map("ranking_score_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  content      Content       @relation(fields: [contentId], references: [id], onDelete: Restrict)
  executor     User?         @relation("PostExecutedBy", fields: [executedBy], references: [id], onDelete: SetNull)
  // The ranking_scores row (selected platform's latest score at publish
  // time) that informed this post. SetNull (not Restrict) because the FK is
  // an informational back-reference, not an ownership edge.
  rankingScore RankingScore? @relation(fields: [rankingScoreId], references: [id], onDelete: SetNull)
  metrics      Metric[]
  comments     Comment[]

  @@index([contentId, status, scheduledAt])
  // BUG-QA-001: a Postgres PARTIAL unique index
  // `posts_content_platform_active_key` UNIQUE (content_id, platform)
  // WHERE status NOT IN ('failed','cancelled') enforces "at most one active
  // publish intent per (content, platform)". It cannot be expressed as a
  // Prisma `@@unique` (no WHERE clause), so it lives only in the hand-written
  // migration 20260718000000_bugqa001_posts_active_publish_unique. Kept in
  // sync with ACTIVE_PUBLISH_STATUSES in publish-orchestrator.service.ts.
  @@map("posts")
}

// Phase 2 Pass B addition. One row per (content, platform) per ranking
// computation. `reasoning` stores the full explainable factor breakdown
// ({factors: [{name, input, weight, value, contribution}], total}) so the
// UI can render *why* a platform was recommended — the engine is a
// transparent weighted rule set, never a black box.
model RankingScore {
  id            String        @id @default(uuid()) @db.Uuid
  contentId     String        @map("content_id") @db.Uuid
  platform      AssetPlatform
  score         Decimal       @db.Decimal(10, 4)
  reasoning     Json
  engineVersion EngineVersion @map("engine_version")
  computedAt    DateTime      @default(now()) @map("computed_at")

  content Content @relation(fields: [contentId], references: [id], onDelete: Restrict)
  posts   Post[]

  @@index([contentId, computedAt])
  @@map("ranking_scores")
}

model Metric {
  id          String       @id @default(uuid()) @db.Uuid
  postId      String       @map("post_id") @db.Uuid
  platform    Platform
  reach       Int
  engagement  Int
  revenue     Decimal      @db.Decimal(12, 2)
  source      MetricSource
  collectedAt DateTime     @map("collected_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Restrict)

  @@index([postId, collectedAt])
  @@map("metrics")
}

model Comment {
  id          String     @id @default(uuid()) @db.Uuid
  postId      String     @map("post_id") @db.Uuid
  platform    Platform
  author      String
  text        String
  sentiment   Sentiment?
  collectedAt DateTime   @map("collected_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  // --- Phase 4 additions (all nullable/defaulted; legacy rows stay valid) ---
  // Platform-native comment id. Namespaced by `platform` in the dedup key so
  // FB/YT id-format differences can never collide (risk R8). Nullable so any
  // pre-Phase-4 seed row without one stays valid; Postgres treats NULL as
  // DISTINCT in a unique index, so multiple legacy nulls never conflict.
  externalCommentId String?          @map("external_comment_id")
  // Stable author id from the platform (FB user/psid, YT channelId). Used for
  // the audit author-reference hash (redact-comment-meta.util) so raw display
  // names stay out of logs.
  authorExternalId  String?          @map("author_external_id")
  priority          CommentPriority? // set by the triage classifier at ingestion
  sentimentSource   SentimentSource? @map("sentiment_source")
  slaDueAt          DateTime?        @map("sla_due_at")
  // Per-comment reply capability (risk R3): FB/YT both have non-replyable
  // comment types. Captured at ingestion from the adapter; UI disables reply
  // when false. Defaults true so a legacy/manual row is assumed replyable.
  replyable         Boolean          @default(true)
  // Reply outcome (written only by the audited reply flow, comment-reply.service).
  repliedAt         DateTime?        @map("replied_at")
  repliedBy         String?          @map("replied_by") @db.Uuid
  replyText         String?          @map("reply_text")
  replyExternalId   String?          @map("reply_external_id")

  post    Post  @relation(fields: [postId], references: [id], onDelete: Restrict)
  replier User? @relation("CommentRepliedBy", fields: [repliedBy], references: [id], onDelete: SetNull)

  @@index([postId])
  // Read-model filter/sort support (inbox lists by these).
  @@index([platform, sentiment, priority, slaDueAt])
  // DEDUP KEY — DB-enforced, not app-layer (BUG-QA-001 / QA-OBS-1 lesson).
  // The AUTHORITATIVE index is a hand-written PARTIAL unique index
  //   comments_platform_external_key UNIQUE (platform, external_comment_id)
  //   WHERE external_comment_id IS NOT NULL
  // in migration 20260719120000_phase4_comment_aggregation (Prisma's `@@unique`
  // cannot express a WHERE clause — identical convention to
  // posts_content_platform_active_key). Deliberately NOT declared as a Prisma
  // `@@unique` here so Prisma does not emit a second, full unique index.
  @@map("comments")
}

// Phase 4 addition. Admin-owned canned reply templates (capability g). CRUD
// only; inserting a template into a reply still goes through the full
// step-up reply flow (comment-reply.service).
model CommentReplyTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  body      String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("comment_reply_templates")
}

// Phase 4 addition. The alert-dedup ledger (capability f). ONE row per active
// spike window. The (ruleKey, windowStart) UNIQUE is the hard dedup control
// the System Analyst requires at the DB layer — an app-layer check alone is
// what QA-OBS-1 warned against. Re-running escalation over the same window is
// an idempotent no-op (P2002 caught -> skip), so a spike raises exactly one
// alert (exit #5).
model EscalationAlert {
  id             String    @id @default(uuid()) @db.Uuid
  // Identifies the rule + partition. Phase 4 default: "negative_spike". Stable string.
  ruleKey        String    @map("rule_key")
  windowStart    DateTime  @map("window_start")
  windowEnd      DateTime  @map("window_end")
  negativeCount  Int       @map("negative_count")
  threshold      Int
  raisedAt       DateTime  @default(now()) @map("raised_at")
  // Soft-acknowledge so the UI can dismiss a handled alert without deleting the
  // ledger row (deleting would let the same window re-fire — dedup must persist).
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([ruleKey, windowStart]) // DB-enforced alert dedup
  @@index([raisedAt])
  @@map("escalation_alerts")
}

// --- Phase 5D.1 addition (durable audit trail) --------------------------
// Additive-only per the header rule.

// Outcome of an audited operation. Mirrors AuditResult in
// common/audit/audit-log.service.ts. A two-value enum rather than a boolean
// so a third outcome (e.g. "denied") can be appended without a data migration.
enum AuditLogResult {
  success
  failure
}

// Phase 5D.1. Durable audit trail.
//
// Phase 1 emitted audit entries as structured JSON to stdout and deferred a
// table as "a Phase 2+ concern"; it was never picked up. That was proved to be
// real data loss, not a theoretical gap: eight manual_external posts recorded
// 12:30–15:32 left ZERO audit lines after a routine container recreate at
// 15:42 (docs/phase5-bugfix-feedback.md §5.3). It matters because
// bussiness_rule.md justifies enforcing the copyright gate on the
// manual-external path ENTIRELY on audit-trail grounds — a justification that
// did not survive a restart. Rows are written IN ADDITION to the stdout line,
// which is kept (useful in dev, and some deployments tail it).
//
// `action` is a String, not an enum, on purpose: the AuditAction union in
// audit-log.service.ts is the typed source of truth and has grown in every
// phase. A Prisma enum would force a schema migration for each new action and
// make an unknown action a hard write failure — an audit sink must never
// refuse to record something. Indexed, so it stays queryable either way.
//
// `meta` is written ONLY after redactSensitive() — the same redaction the log
// line gets. Never persist raw passwords/tokens; comment PII rules from
// Phase 4 hold here too (authorRef/textLength only, never raw author/text).
model AuditLog {
  id        String         @id @default(uuid()) @db.Uuid
  // When the event happened (set by the service), distinct from createdAt,
  // which is when the row landed. The write is asynchronous, so they differ.
  timestamp DateTime       @default(now())
  // Nullable for system/unattended actors (cron, queue workers). Not a FK to
  // users: the trail must outlive the user row and can record "anonymous"
  // pre-auth events.
  actor     String?
  action    String
  result    AuditLogResult
  ip        String?
  meta      Json?
  createdAt DateTime       @default(now()) @map("created_at")

  // "What happened to X, and when" — the two queries an audit trail exists to
  // answer. Both are (filter, time) so they serve filter+sort in one index.
  @@index([action, createdAt])
  @@index([actor, createdAt])
  @@map("audit_logs")
}

// =========================================================================
// Phase 6 additions — Commerce / Affiliate
// =========================================================================
//
// Additive-only per the header rule. See docs/phase6-architecture-design.md
// §1 and docs/phase6-system-analysis.md (conditions A1–A6, B1–B7).
//
// THE LOAD-BEARING STRUCTURAL CHOICE (design §2.1, ADR-6.1), stated here
// because this is where the next person will be standing when they try to
// "tidy up" the schema:
//
//   NO commerce model below declares a Prisma relation to `Post`, `Content`,
//   `ContentAsset` or `User`. Those columns are plain `String @db.Uuid`, and
//   their FOREIGN KEYs are hand-written ALTER TABLE DDL in the migration
//   20260721000000_phase6_commerce — the same technique this schema already
//   uses for `posts_content_platform_active_key`.
//
// Why: Prisma requires a back-relation on BOTH sides. The moment
// `ProductAnchor` declares `post Post @relation(...)`, Prisma FORCES `Post`
// to gain `productAnchors ProductAnchor[]`, and from that moment
//     this.prisma.post.findMany({ include: { productAnchors: true } })
// is a legal, type-checked call inside DashboardService. Commerce revenue
// reaching a payout dashboard would then be prevented only by nobody writing
// that line. With no relation field the traversal is not merely discouraged —
// it is UNSPELLABLE. Postgres still enforces referential integrity.
//
// If you add a relation field here you have removed the phase's primary
// separation guarantee. Do not. Relations WITHIN the commerce namespace
// (product → links → anchors → placements) are declared normally; the
// boundary is only at the edge of the namespace.

// Commerce/affiliate channel. DELIBERATELY NOT a value on `Platform` or
// `AssetPlatform` — see the warning block on `AssetPlatform`.
enum CommerceChannel {
  shopee
  tiktok_shop
}

// Provenance, mirroring MetricSource(api|manual). Every commerce table carries
// it so that if API access is ever granted (none exists today — no Shopee KAM,
// no TikTok Shop Creator Affiliate), API-sourced rows are distinguishable from
// hand-entered ones without a migration.
//
// Deliberately NOT a reuse of `MetricSource`: reusing it would put a
// metrics-namespaced type on commerce rows and create exactly the conceptual
// bridge the separation exists to prevent.
enum CommerceSource {
  manual
  api
}

// Lifecycle of a Shopee video placement. Two values only: this phase records
// placements that already exist natively. Upload-state values (`uploading`,
// `processing`) belong to the live path, which is not built (no API access);
// appending them later is additive and safe.
enum CommercePlacementStatus {
  recorded
  removed
}

/// One row per sellable product the admin promotes. No FK to `Content`: a
/// product is promoted across many contents and a content promotes many
/// products, so linking them directly would be wrong at both ends.
model CommerceProduct {
  id                String          @id @default(uuid()) @db.Uuid
  channel           CommerceChannel
  externalProductId String          @map("external_product_id")
  name              String
  sku               String?
  productUrl        String?         @map("product_url")
  listPrice         Decimal?        @map("list_price") @db.Decimal(12, 2)
  currency          String          @default("THB") @db.Char(3)
  /// INDICATIVE ONLY. Never multiplied by sales anywhere in the codebase —
  /// actual earnings are always the entered CommerceConversion.commissionAmount
  /// from the platform statement.
  commissionRatePct Decimal?        @map("commission_rate_pct") @db.Decimal(5, 2)
  isActive          Boolean         @default(true) @map("is_active")
  retiredAt         DateTime?       @map("retired_at")
  source            CommerceSource  @default(manual)
  /// SQL FK → users(id) ON DELETE RESTRICT. No Prisma relation (see header).
  createdBy         String          @map("created_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  links   AffiliateLink[]
  anchors ProductAnchor[]

  @@unique([channel, externalProductId])
  @@index([channel, isActive, name])
  @@map("commerce_products")
}

/// One row per (product × tracking link). Its own table, not a column on the
/// product, because one product accumulates several tracking links over time
/// and a conversion must attribute to the link that earned it.
///
/// `channel` is deliberately ABSENT (design refinement vs the plan): channel is
/// a property of the product and a denormalised copy here can drift into a
/// meaningless-but-insertable state (a `shopee` product carrying a
/// `tiktok_shop` link). A genuine cross-channel case is modelled as a second
/// product row, which UNIQUE(channel, external_product_id) already anticipates.
model AffiliateLink {
  id           String         @id @default(uuid()) @db.Uuid
  productId    String         @map("product_id") @db.Uuid
  url          String
  trackingCode String?        @map("tracking_code")
  subId        String?        @map("sub_id")
  isActive     Boolean        @default(true) @map("is_active")
  retiredAt    DateTime?      @map("retired_at")
  source       CommerceSource @default(manual)
  createdBy    String         @map("created_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  product CommerceProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  anchors ProductAnchor[]

  /// Not a business rule — this exists purely as the target for the composite
  /// FK on product_anchors(affiliate_link_id, product_id), which is what makes
  /// "a link may only be attached to an anchor for its OWN product" a database
  /// guarantee rather than an app-code convention.
  @@unique([id, productId])
  @@unique([productId, url])
  @@index([productId, isActive])
  @@map("affiliate_links")
}

/// "This product was ปักตะกร้า on this video." Anchors to a `Post` OR a
/// `CommercePlacement` — exactly one, enforced by a CHECK. Anchoring at Post
/// grain (not Content) is deliberate: the same content posted to TikTok and to
/// Shopee may pin different products, and losing which video carried which
/// product would defeat the feature.
///
/// Soft-remove via `removedAt` (never hard-deleted) with PARTIAL unique
/// indexes WHERE removed_at IS NULL, so an un-anchor → re-anchor cycle is
/// possible without destroying history.
model ProductAnchor {
  id              String         @id @default(uuid()) @db.Uuid
  /// SQL FK → posts(id). NO Prisma relation (see header).
  postId          String?        @map("post_id") @db.Uuid
  placementId     String?        @map("placement_id") @db.Uuid
  productId       String         @map("product_id") @db.Uuid
  affiliateLinkId String?        @map("affiliate_link_id") @db.Uuid
  /// Ordering in the basket UI. NOT unique per target — ties break by
  /// `anchoredAt` (Phase 6.0 decision; see the commerce constants).
  anchorPosition  Int?           @map("anchor_position")
  anchoredAt      DateTime       @default(now()) @map("anchored_at")
  removedAt       DateTime?      @map("removed_at")
  source          CommerceSource @default(manual)
  /// SQL FK → users(id). NO Prisma relation.
  recordedBy      String         @map("recorded_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")

  product       CommerceProduct    @relation(fields: [productId], references: [id], onDelete: Restrict)
  affiliateLink AffiliateLink?     @relation(fields: [affiliateLinkId], references: [id], onDelete: Restrict)
  placement     CommercePlacement? @relation(fields: [placementId], references: [id], onDelete: Restrict)

  @@index([postId])
  @@index([placementId])
  @@index([productId])
  @@map("product_anchors")
}

/// One row per Shopee video placement. A PARALLEL to `Post`, not a `Post` row —
/// putting Shopee into `posts` would have required a fifth `Platform` value,
/// which is irreversible and would have enrolled commerce into ranking.
model CommercePlacement {
  id              String                  @id @default(uuid()) @db.Uuid
  /// SQL FK → contents(id). NO Prisma relation (see header).
  contentId       String                  @map("content_id") @db.Uuid
  channel         CommerceChannel
  externalMediaId String                  @map("external_media_id")
  externalUrl     String?                 @map("external_url")
  status          CommercePlacementStatus @default(recorded)
  /// Reuses the EXISTING PublishMethod enum unchanged — no new enum, and
  /// `adapter` becomes meaningful the day a live upload path exists.
  publishMethod   PublishMethod           @default(manual_external) @map("publish_method")
  /// SQL FK → content_assets(id) ON DELETE SET NULL. NO Prisma relation.
  sourceAssetId   String?                 @map("source_asset_id") @db.Uuid
  mediaUrl        String?                 @map("media_url")
  /// Nullable at the column so a future tiktok_shop placement without a
  /// duration stays representable; commerce_placements_shopee_duration_chk
  /// makes it effectively NOT NULL for `shopee`.
  durationSeconds Int?                    @map("duration_seconds")
  /// ⚠ FREE TEXT — one of exactly two columns in the commerce schema capable
  /// of holding personal data if an admin deliberately types it. Capped at 200
  /// characters (System Analyst condition A4, reduced from the design's 500).
  /// Never written to audit_logs.meta; never exported. Clearable in place —
  /// see COMMERCE_ERASABLE_FREE_TEXT_COLUMNS.
  note            String?
  /// Optimistic-concurrency guard, same as Post.version.
  version         Int                     @default(0)
  source          CommerceSource          @default(manual)
  /// SQL FK → users(id). NO Prisma relation.
  recordedBy      String                  @map("recorded_by") @db.Uuid
  placedAt        DateTime                @default(now()) @map("placed_at")
  removedAt       DateTime?               @map("removed_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  anchors ProductAnchor[]

  @@index([contentId, status])
  @@index([channel, placedAt])
  @@map("commerce_placements")
}

/// One row per commission/conversion figure entered from a platform payout
/// statement. APPEND-ONLY: no `updatedAt`, no PATCH/DELETE route. A refund or
/// cancelled order is a NEW row with a negative `commissionAmount`, optionally
/// naming the row it reverses via `reversalOfId` — never an edit.
///
/// This table is the reason Phase 6 exists as a separate stream. It has NO FK
/// to `Metric`, no relation to it, and nothing under modules/ranking,
/// modules/metrics, modules/dashboard or modules/reports may read it. That is
/// enforced by ESLint zones, a static boundary scan, and the byte-identity
/// e2e proof — see docs/phase6-system-analysis.md §2.
///
/// PDPA: there is NO buyer_*, order_id, recipient, address, phone or email
/// column, and no per-transaction identifier. `ordersCount` / `itemsSold` are
/// aggregate counters and cannot hold an identifier. Commerce introduces no
/// new data subject: the only personal data is `recordedBy`, the single admin.
model CommerceConversion {
  id               String          @id @default(uuid()) @db.Uuid
  channel          CommerceChannel
  /// DATE, not TIMESTAMP: statements are day-grained, and a timestamp invites
  /// a timezone bug in overlap detection.
  periodStart      DateTime        @map("period_start") @db.Date
  periodEnd        DateTime        @map("period_end") @db.Date
  /// AGGREGATE COUNTS ONLY. Nullable — many statement lines carry a commission
  /// with no count.
  ordersCount      Int?            @map("orders_count")
  itemsSold        Int?            @map("items_sold")
  grossSalesAmount Decimal?        @map("gross_sales_amount") @db.Decimal(12, 2)
  /// MAY BE NEGATIVE — refunds/reversals are new rows, never edits. This is
  /// the documented divergence from `Metric`, which has no reversal concept,
  /// and it is why escapeCsvField had to learn not to formula-prefix a
  /// negative number (see common/utils/csv.util.ts).
  commissionAmount Decimal         @map("commission_amount") @db.Decimal(12, 2)
  currency         String          @default("THB") @db.Char(3)
  /// All four attribution columns are NULLABLE — an unattributed statement
  /// line ("commission, week 29") is a normal, expected case.
  /// SQL FKs only; NO Prisma relation into posts.
  postId           String?         @map("post_id") @db.Uuid
  placementId      String?         @map("placement_id") @db.Uuid
  productId        String?         @map("product_id") @db.Uuid
  affiliateLinkId  String?         @map("affiliate_link_id") @db.Uuid
  /// ⚠ FREE TEXT — the second of exactly two PII-capable columns, and the
  /// highest-residual one. Max 64 chars AND format-constrained to
  /// COMMERCE_STATEMENT_REF_PATTERN (no spaces, so a pasted Latin-script name
  /// fails) in the SERVICE, not only the DTO — the adapter ingestion path
  /// never touches class-validator. Never audited, never exported.
  statementRef     String?         @map("statement_ref")
  /// Self-FK: a reversal row may name the row it reverses. Its ABSENCE would
  /// create PDPA pressure — without it, "which correction cancels which line"
  /// is only recoverable by eye from statement_ref, pushing the admin toward
  /// pasting an order id there.
  reversalOfId     String?         @map("reversal_of_id") @db.Uuid
  source           CommerceSource  @default(manual)
  recordedBy       String          @map("recorded_by") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")

  @@index([channel, periodStart, periodEnd])
  @@index([productId, periodStart])
  @@index([placementId])
  @@index([createdAt])
  @@map("commerce_conversions")
}

// =========================================================================
// Phase 7 additions — Paid/Ads Visibility (Schema & Separation Gate, 7.0)
// =========================================================================
//
// Additive-only per the header rule. See docs/phase7-architecture-design.md
// §1 (AS CORRECTED by docs/phase7-system-analyst-signoff.md conditions
// P-A1–P-A4, P-B1–P-B4, SA-P1–SA-P7 — the design draft's own quoted
// `sourceRef` regex was defective; do not copy it from that document).
//
// THE LOAD-BEARING STRUCTURAL CHOICE, restated a third time (design §2.1):
//
//   NEITHER `AdCampaign` NOR `AdPerformanceEntry` declares a Prisma relation
//   to `Content` or `User`. `content_id` / `created_by` / `recorded_by` are
//   plain `String @db.Uuid`; their FOREIGN KEYs are hand-written `ALTER TABLE`
//   DDL in migration 20260721010000_phase7_paid_visibility — the same
//   technique Commerce already uses. Postgres enforces referential integrity;
//   `Content` and `User` gain no new field, so there is no `include` that
//   reaches `ad_campaigns` from `DashboardModule`, `MetricsModule`,
//   `RankingModule`, `ReportsModule` or `CommerceModule`. The traversal is
//   unspellable, not merely forbidden — do not add a relation field here.
//
//   The relation from `AdPerformanceEntry` to `AdCampaign` IS a normal Prisma
//   relation — it is WITHIN the paid namespace, not a boundary crossing,
//   mirroring `AffiliateLink.product CommerceProduct @relation(...)`.
//
// This is a THIRD, independent stream from payout and commerce — no
// discriminator on `Metric`, no FK to `Metric`/`CommerceConversion`, and
// nothing under modules/ranking, modules/metrics, modules/dashboard or
// modules/commerce may read it. Enforced by three-way ESLint zones, a static
// boundary scan and a byte-identity e2e proof — see
// docs/phase7-commerce-paid-pdpa-separation-policy.md.
//
// PDPA (Decision 5, hard rule): there is NO audience-targeting, custom-
// audience/lookalike, or individual click/impression-level column, and never
// will be without a fresh decision. `reach`/`impressions`/`clicks`/
// `resultCount` are AGGREGATE counters only. The two free-text columns
// (`objective`, `sourceRef`) are the entire residual PDPA surface — see
// PAID_SOURCE_REF_PATTERN and PAID_ERASABLE_FREE_TEXT_COLUMNS in
// backend/src/modules/paid/paid.constants.ts.

// Ad channel. DELIBERATELY NOT a value on `Platform` or `AssetPlatform` — see
// the warning block on `AssetPlatform`. One value this phase (Meta-only,
// phase7-project-plan.md Decision 3); a second channel is an honest additive
// migration later, not a speculative abstraction built now.
enum AdChannel {
  meta
}

// The admin's manual read of the REAL Meta campaign's lifecycle stage —
// nothing here is live-synced (Decision 2/P-C, no MCP/API coupling this
// phase). Deliberately a SEPARATE axis from Content Hub's own soft-retire
// (`AdCampaign.isActive`/`retiredAt`, ADR-7.5): a campaign can be `ended` in
// Meta Ads Manager for months before the admin retires the Content Hub
// record, and conversely a record can be retired from the picker while still
// showing `active` for historical accuracy.
enum AdCampaignStatus {
  active
  paused
  ended
}

// Provenance, mirroring CommerceSource(manual|api). Every paid table carries
// it so that if the 7D live-sync path (standard Meta Marketing/Insights API,
// NOT the Ads MCP) is ever built, API-sourced rows are distinguishable from
// hand-entered ones without a migration.
//
// Deliberately NOT a reuse of `CommerceSource`: reusing it would put a
// commerce-namespaced type on paid rows, creating exactly the conceptual
// bridge the separation exists to prevent (the identical argument
// `CommerceSource` itself made relative to `MetricSource` in Phase 6).
enum AdSource {
  manual
  api
}

/// One row per Meta ad campaign the admin logs. No FK to `Post`: a campaign
/// commonly promotes a pillar or several pieces of content rather than one
/// platform-native publish event (ADR-7.4) — the nullable `contentId` links
/// to `Content` instead, and only when a single piece of content is the
/// primary attribution target; an unlinked campaign is a normal, expected
/// state, exactly like `CommerceConversion`'s all-nullable attribution
/// columns.
model AdCampaign {
  id                   String           @id @default(uuid()) @db.Uuid
  channel              AdChannel
  externalCampaignName String           @map("external_campaign_name")
  externalCampaignId   String?          @map("external_campaign_id")
  /// FREE TEXT, capped at 100 chars (System Analyst SA-P4: excluded from
  /// `audit_logs.meta` for all 5 paid actions, consistent with Commerce's
  /// blanket free-text exclusion, not just the higher-residual `sourceRef`).
  /// Not format-regexed — a short categorical label ("Traffic", "Conversions"),
  /// not a business-reconciliation reference an admin might pad with extra
  /// identifying detail. See PAID_ERASABLE_FREE_TEXT_COLUMNS.
  objective            String
  /// SQL FK → contents(id) ON DELETE SET NULL. NO Prisma relation (see header).
  contentId            String?          @map("content_id") @db.Uuid
  startDate            DateTime         @map("start_date") @db.Date
  /// NULL means "still running" — a real, common state; there is no honest
  /// non-null placeholder for "no end date yet".
  endDate              DateTime?        @map("end_date") @db.Date
  /// INDICATIVE ONLY (System Analyst SA-P5). Never summed with, or reconciled
  /// against, AdPerformanceEntry.spend anywhere in the codebase — actual cost
  /// is always the entered spend figures. Mirrors CommerceProduct.commissionRatePct.
  plannedBudget        Decimal?         @map("planned_budget") @db.Decimal(12, 2)
  /// THB only, v1 (admin-confirmed 2026-07-21, bussiness_rule.md "Phase 7
  /// OQ-4 answer"). CHECK enforces ISO-4217 SHAPE only; PAID_SUPPORTED_CURRENCIES
  /// is the v1 service-level restriction (SA-P6) — relaxing that later is free,
  /// adding this column/CHECK later would not have been.
  currency             String           @default("THB") @db.Char(3)
  /// The admin's manual read of Meta's real lifecycle state (see AdCampaignStatus).
  status               AdCampaignStatus @default(active)
  /// Content Hub's OWN soft-retire — never hard-delete. Independent axis from
  /// `status` above. Mirrors CommerceProduct.isActive/retiredAt.
  isActive             Boolean          @default(true) @map("is_active")
  retiredAt            DateTime?        @map("retired_at")
  source               AdSource         @default(manual)
  /// SQL FK → users(id) ON DELETE RESTRICT. NO Prisma relation (see header).
  createdBy            String           @map("created_by") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  performanceEntries AdPerformanceEntry[]

  @@unique([channel, externalCampaignId])
  @@index([channel, isActive, externalCampaignName])
  @@index([contentId])
  @@map("ad_campaigns")
}

/// One row per spend/results figure the admin logs against a campaign,
/// APPEND-ONLY: no `updatedAt`, no PATCH/DELETE route (exit criterion #3). A
/// data-entry correction is a NEW row naming the row it corrects via
/// `correctsEntryId` — deliberately NOT a reversal/negative-amount mechanic
/// (ADR-7.2): ad spend has no real-world refund event the way a commission
/// chargeback does, so every numeric field here is CHECK'd non-negative,
/// with no signed-amount case to escape in the CSV export.
///
/// PDPA: there is NO buyer_*, recipient, audience, custom-audience or
/// individual click/impression-identifier column. `reach`/`impressions`/
/// `clicks`/`resultCount` are AGGREGATE counters and cannot hold an
/// identifier. Paid introduces no new data subject: the only personal data is
/// `recordedBy`, the single admin.
model AdPerformanceEntry {
  id              String   @id @default(uuid()) @db.Uuid
  /// Normal Prisma relation — WITHIN the paid namespace, not a boundary
  /// crossing. Mirrors AffiliateLink.product CommerceProduct @relation(...).
  campaignId      String   @map("campaign_id") @db.Uuid
  /// CHECK (spend >= 0) — NEVER negative; see the model docblock.
  spend           Decimal  @db.Decimal(12, 2)
  /// AGGREGATE ONLY. CHECK (reach IS NULL OR reach >= 0).
  reach           Int?
  /// AGGREGATE ONLY. CHECK (impressions IS NULL OR impressions >= 0).
  impressions     Int?
  /// AGGREGATE ONLY. CHECK (clicks IS NULL OR clicks >= 0).
  clicks          Int?
  /// FREE-TEXT label ("Purchases", "Leads", "Link clicks"), paired with
  /// resultCount; both nullable together (a just-started campaign with no
  /// result yet is a legitimate state).
  resultType      String?  @map("result_type")
  /// CHECK (result_count IS NULL OR result_count >= 0).
  resultCount     Int?     @map("result_count")
  /// THB only, v1 — see AdCampaign.currency. Independent of the campaign's own
  /// currency column (mirrors Commerce's SA-9 precedent: a performance entry
  /// is the actual transactional record and must be self-consistent on its own
  /// terms, never reconciled against the campaign's planned-budget currency).
  currency        String   @default("THB") @db.Char(3)
  /// DATE, not TIMESTAMP: Ads Manager summary screens are day-grained, and a
  /// timestamp invites a timezone bug in overlap detection. Mirrors
  /// CommerceConversion.periodStart/periodEnd exactly.
  periodStart     DateTime @map("period_start") @db.Date
  periodEnd       DateTime @map("period_end") @db.Date
  /// ⚠ FREE TEXT — the higher-residual of the two PDPA free-text columns.
  /// Max 64 chars AND format-constrained to PAID_SOURCE_REF_PATTERN (no
  /// spaces, so a pasted Latin-script name fails) in the SERVICE (7A), not
  /// only the DTO — mirrors COMMERCE_STATEMENT_REF_PATTERN exactly (System
  /// Analyst P-A1/SA-P1: the design draft's own quoted regex contained a
  /// space and would have let a pasted name through; do not use it). Never
  /// audited, never exported. See PAID_ERASABLE_FREE_TEXT_COLUMNS.
  sourceRef       String?  @map("source_ref")
  /// Self-FK, SQL-level ONLY, NO Prisma relation (mirrors
  /// CommerceConversion.reversalOfId's treatment). CHECK (corrects_entry_id
  /// <> id) — a row cannot correct itself (System Analyst P-A3). The service
  /// additionally validates the corrected entry belongs to the SAME
  /// campaignId (7A) — a DB-level cross-campaign check would need a
  /// composite FK this schema does not carry.
  correctsEntryId String?  @map("corrects_entry_id") @db.Uuid
  source          AdSource @default(manual)
  /// SQL FK → users(id) ON DELETE RESTRICT. NO Prisma relation (see header).
  recordedBy      String   @map("recorded_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@index([campaignId, periodStart, periodEnd])
  @@index([createdAt])
  @@map("ad_performance_entries")
}
