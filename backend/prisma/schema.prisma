// Content Hub — Phase 1 database schema
//
// IMPORTANT (System Analyst security decision #9): Prisma enum migrations must
// be treated as ADDITIVE-ONLY. Never remove or reorder existing enum values in
// a migration — Postgres enum value removal/reorder is destructive and cannot
// be safely rolled back once rows reference the value. Only ever append new
// values. This is a process rule (not enforceable by Prisma itself), documented
// here and in docs/security-decisions.md.
//
// IMPORTANT (System Analyst security decision #5): raw SQL escape hatches
// ($queryRawUnsafe / $executeRawUnsafe) are BANNED across this codebase. Only
// Prisma's parameterized query builder (or $queryRaw / $executeRaw with
// tagged-template parameter binding, used only where Prisma's query builder
// truly cannot express the query — e.g. the CHECK constraint below, which is
// DDL added by hand in a migration file, not a runtime query) may be used.
// See .eslintrc.cjs `no-restricted-properties` rule.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
}

enum Platform {
  facebook
  youtube
  tiktok
  line
}

enum ConnectedAccountStatus {
  connected
  disconnected
  expired
  revoked
}

enum ContentType {
  video
  image
  text
}

enum ContentStatus {
  draft
  ready
  archived
}

enum LicensingStatus {
  unlicensed
  pending_review
  licensed
  exempt
}

enum PostStatus {
  draft
  scheduled
  posted
  failed
  cancelled
  posted_unconfirmed // Phase 2 addition, appended per the additive-only enum rule above. See docs/publish-orchestration-addendum.md.
}

enum MetricSource {
  api
  manual
}

enum Sentiment {
  positive
  negative
  neutral
}

// --- Phase 1.5 additions (Compliance & Schema Gate) ---------------------
// See docs/security-decisions.md / System Analyst Phase 1.5 approval for
// the full rationale. These enums/models are schema-only in this
// iteration: no controller, no publish-flow wiring yet (Phase 2+).

enum ContentPillar {
  product
  drama
  comedy
}

// DB enum labels use the literal age-band strings from the business rule
// doc (e.g. "18-22"), which aren't valid bare Prisma identifiers (leading
// digit, hyphen), hence the @map on each value.
enum TargetAgeSegment {
  age_18_22   @map("18-22")
  age_23_30   @map("23-30")
  age_31_45   @map("31-45")
  age_46_plus @map("46+")
}

// Deliberately not a boolean (System Analyst Condition #3): "blocked" must
// be distinguishable from "not yet reviewed" so a blocked item can never be
// confused with one that simply hasn't been checked yet.
enum CopyrightClearance {
  not_checked
  cleared
  blocked
}

// Separate from the existing `Platform` enum (which is Phase 1's
// connected-account/post/metric/comment platform set and, per the
// additive-only enum rule at the top of this file, must never be renamed).
// The Analyst's Phase 1.5 spec names this platform "line_oa" specifically
// (LINE Official Account) rather than reusing Phase 1's generic "line" —
// kept as its own enum so the two concerns don't get conflated and Phase 1
// data is untouched.
enum AssetPlatform {
  facebook
  youtube
  tiktok
  line_oa
}

// DB enum labels are the literal ratio strings ("1:1" etc.), not valid bare
// identifiers, hence @map on each value.
enum AspectRatio {
  ratio_1_1  @map("1:1")
  ratio_4_5  @map("4:5")
  ratio_9_16 @map("9:16")
  ratio_16_9 @map("16:9")
}

enum CadencePeriodUnit {
  week
  month
}

// Phase 2 Pass B addition. Version of the ranking engine that produced a
// RankingScore row. v1 is the explainable rule-based engine
// (RankingEngineService); v2 is reserved for a future learned/refined
// engine so historical scores stay attributable to the logic that made
// them. Additive-only, like every enum in this file.
enum EngineVersion {
  v1
  v2
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String
  email               String    @unique
  passwordHash        String    @map("password_hash")
  role                UserRole  @default(admin)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  connectedAccounts ConnectedAccount[]
  contents          Content[]          @relation("ContentCreatedBy")
  executedPosts     Post[]             @relation("PostExecutedBy")

  @@map("users")
}

model ConnectedAccount {
  id                    String                 @id @default(uuid()) @db.Uuid
  userId                String                 @map("user_id") @db.Uuid
  platform              Platform
  platformAccountId     String                 @map("platform_account_id")
  platformAccountName   String                 @map("platform_account_name")
  // Nullable by deviation from the literal spec ("text", not marked nullable):
  // the mandatory security fix "DELETE /connected-accounts/:id ... overwrite
  // encrypted token columns to null" requires this column to accept NULL.
  // See docs/security-decisions.md for the reasoning.
  accessTokenEncrypted  String?                @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String?                @map("refresh_token_encrypted") @db.Text
  tokenExpiresAt        DateTime               @map("token_expires_at")
  scopes                String[]
  status                ConnectedAccountStatus @default(connected)
  connectedAt           DateTime               @default(now()) @map("connected_at")
  disconnectedAt        DateTime?              @map("disconnected_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, platform, platformAccountId])
  @@index([status])
  @@map("connected_accounts")
}

model Content {
  id                   String             @id @default(uuid()) @db.Uuid
  type                 ContentType
  title                String
  mediaUrl             String             @map("media_url")
  caption              String?
  targetAgeMin         Int                @map("target_age_min")
  targetAgeMax         Int                @map("target_age_max")
  status               ContentStatus      @default(draft)
  licensingStatus      LicensingStatus    @default(unlicensed) @map("licensing_status")
  licenseNotes         String?            @map("license_notes")
  licenseExpiresAt     DateTime?          @map("license_expires_at") @db.Date
  // Phase 2 additions (upload metadata) — nullable: Phase 1 rows and any
  // future text-only content have no uploaded file to describe.
  fileSizeBytes        BigInt?            @map("file_size_bytes")
  mimeType             String?            @map("mime_type")
  // Phase 1.5 additions (Compliance & Schema Gate) ------------------------
  // `contentPillar` is nullable: unlike `copyrightCleared` (which has an
  // honest "not yet reviewed" state to default to), there is no neutral
  // value among product/drama/comedy that would accurately describe
  // existing/legacy content. Rather than fabricate one, this stays
  // unclassified (null) until an admin assigns it. The copyright-gate
  // service (see copyright-gate.service.ts) treats null the same as a
  // risk-bearing pillar — fail closed, evidence required — so leaving this
  // unset can never widen what's allowed to be marked cleared.
  contentPillar        ContentPillar?     @map("content_pillar")
  // Nullable, intentionally unused this iteration — sub-segment targeting
  // is still an open business decision (see bussiness_rule.md "Target
  // Audience"). Column exists now so it doesn't require another migration
  // once that decision lands.
  targetAgeSegment     TargetAgeSegment?  @map("target_age_segment")
  copyrightCleared     CopyrightClearance @default(not_checked) @map("copyright_cleared")
  copyrightNotes       String?            @map("copyright_notes")
  // Required (by the copyright-gate service, not a DB constraint) for
  // drama/product pillar content before copyrightCleared may become
  // `cleared` — System Analyst Condition #3.
  copyrightEvidenceUrl String?            @map("copyright_evidence_url")
  createdBy            String             @map("created_by") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  creator       User           @relation("ContentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  posts         Post[]
  assets        ContentAsset[]
  rankingScores RankingScore[]

  @@index([status, createdBy, licensingStatus])
  @@map("contents")
}

// Phase 1.5 addition. One row per platform-specific render/crop of a piece
// of Content (e.g. a 9:16 TikTok cut vs. a 1:1 Facebook feed cut of the
// same source). Schema-only this iteration — nothing writes to this table
// yet (Phase 2 CMS asset pipeline will).
model ContentAsset {
  id          String        @id @default(uuid()) @db.Uuid
  contentId   String        @map("content_id") @db.Uuid
  platform    AssetPlatform
  aspectRatio AspectRatio   @map("aspect_ratio")
  mediaUrl    String        @map("media_url")
  createdAt   DateTime      @default(now()) @map("created_at")

  content Content @relation(fields: [contentId], references: [id], onDelete: Restrict)

  @@index([contentId])
  @@map("content_assets")
}

// Phase 1.5 addition. Admin-configurable target split of content pillars.
// Seeded with an explicitly-provisional placeholder split (see
// prisma/seed.ts) pending a real admin decision — nothing reads this table
// yet (Phase 3 ranking engine will).
model PillarRatioPolicy {
  id             String        @id @default(uuid()) @db.Uuid
  contentPillar  ContentPillar @map("content_pillar")
  targetRatioPct Decimal       @map("target_ratio_pct") @db.Decimal(5, 2)
  effectiveFrom  DateTime      @map("effective_from") @db.Date
  isProvisional  Boolean       @default(true) @map("is_provisional")
  createdByNote  String?       @map("created_by_note")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("pillar_ratio_policies")
}

// Phase 1.5 addition. Admin-configurable per-platform posting cadence
// target. Seeded with placeholder values (see prisma/seed.ts) pending a
// real admin decision — nothing reads this table yet (Phase 3 ranking
// engine will).
model PlatformCadenceTarget {
  id                   String            @id @default(uuid()) @db.Uuid
  platform             AssetPlatform
  targetPostsPerPeriod Int               @map("target_posts_per_period")
  periodUnit           CadencePeriodUnit @map("period_unit")
  effectiveFrom        DateTime          @map("effective_from") @db.Date
  isProvisional        Boolean           @default(true) @map("is_provisional")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@map("platform_cadence_targets")
}

model Post {
  id             String     @id @default(uuid()) @db.Uuid
  contentId      String     @map("content_id") @db.Uuid
  platform       Platform
  priorityScore  Decimal?   @map("priority_score") @db.Decimal(10, 4)
  recommendedAt  DateTime?  @map("recommended_at")
  scheduledAt    DateTime?  @map("scheduled_at")
  postedAt       DateTime?  @map("posted_at")
  status         PostStatus @default(draft)
  executedBy     String?    @map("executed_by") @db.Uuid
  externalPostId String?    @map("external_post_id")
  // Phase 2 addition: optimistic-concurrency guard for the publish
  // orchestrator's conditional UPDATEs. See docs/publish-orchestration-addendum.md §2.
  version        Int        @default(0)
  // Phase 2 Pass B additions (ranking-informed publish). All nullable
  // because legacy Phase 1 rows predate the ranking engine.
  // `recommendedPlatform` / `wasOverride` are ALWAYS recomputed server-side
  // from the latest ranking_scores at publish time — never accepted from
  // the client (System Analyst hard constraint).
  recommendedPlatform AssetPlatform? @map("recommended_platform")
  selectedPlatform    AssetPlatform? @map("selected_platform")
  wasOverride         Boolean        @default(false) @map("was_override")
  overrideReason      String?        @map("override_reason")
  rankingScoreId      String?        @map("ranking_score_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  content      Content       @relation(fields: [contentId], references: [id], onDelete: Restrict)
  executor     User?         @relation("PostExecutedBy", fields: [executedBy], references: [id], onDelete: SetNull)
  // The ranking_scores row (selected platform's latest score at publish
  // time) that informed this post. SetNull (not Restrict) because the FK is
  // an informational back-reference, not an ownership edge.
  rankingScore RankingScore? @relation(fields: [rankingScoreId], references: [id], onDelete: SetNull)
  metrics      Metric[]
  comments     Comment[]

  @@index([contentId, status, scheduledAt])
  @@map("posts")
}

// Phase 2 Pass B addition. One row per (content, platform) per ranking
// computation. `reasoning` stores the full explainable factor breakdown
// ({factors: [{name, input, weight, value, contribution}], total}) so the
// UI can render *why* a platform was recommended — the engine is a
// transparent weighted rule set, never a black box.
model RankingScore {
  id            String        @id @default(uuid()) @db.Uuid
  contentId     String        @map("content_id") @db.Uuid
  platform      AssetPlatform
  score         Decimal       @db.Decimal(10, 4)
  reasoning     Json
  engineVersion EngineVersion @map("engine_version")
  computedAt    DateTime      @default(now()) @map("computed_at")

  content Content @relation(fields: [contentId], references: [id], onDelete: Restrict)
  posts   Post[]

  @@index([contentId, computedAt])
  @@map("ranking_scores")
}

model Metric {
  id          String       @id @default(uuid()) @db.Uuid
  postId      String       @map("post_id") @db.Uuid
  platform    Platform
  reach       Int
  engagement  Int
  revenue     Decimal      @db.Decimal(12, 2)
  source      MetricSource
  collectedAt DateTime     @map("collected_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Restrict)

  @@index([postId, collectedAt])
  @@map("metrics")
}

model Comment {
  id          String     @id @default(uuid()) @db.Uuid
  postId      String     @map("post_id") @db.Uuid
  platform    Platform
  author      String
  text        String
  sentiment   Sentiment?
  collectedAt DateTime   @map("collected_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Restrict)

  @@index([postId])
  @@map("comments")
}
