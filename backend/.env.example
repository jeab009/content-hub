# Copy to .env and fill in real values. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGIN=http://localhost:3000

# --- Database ---
DATABASE_URL="postgresql://content_hub:content_hub@localhost:5432/content_hub?schema=public"

# --- Redis ---
# BullMQ uses DB 0, sessions use DB 1 (see modules/queue and main.ts session setup).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_DB=0
REDIS_SESSION_DB=1

# --- Sessions ---
# Long random string used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-64-char-hex-string
SESSION_COOKIE_NAME=content_hub_sid
# 12 hours, sliding, in milliseconds
SESSION_TTL_MS=43200000

# --- Token encryption (AES-256-GCM) ---
# Exactly 32 bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# --- Facebook OAuth (Meta Graph API) ---
FACEBOOK_APP_ID=replace-with-meta-app-id
FACEBOOK_APP_SECRET=replace-with-meta-app-secret
# Must exactly match a redirect URI registered in the Meta App dashboard.
FACEBOOK_REDIRECT_URI=http://localhost:4000/api/connected-accounts/facebook/callback
FACEBOOK_GRAPH_API_VERSION=v21.0
FACEBOOK_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts

# --- Seed script ---
# If unset, the seed script generates a random password and prints it once —
# it is never hardcoded or committed. See prisma/seed.ts.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Content Hub Admin
SEED_ADMIN_PASSWORD=
