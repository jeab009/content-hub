# Copy to .env and fill in real values. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGIN=http://localhost:3000

# --- Database ---
DATABASE_URL="postgresql://content_hub:content_hub@localhost:5432/content_hub?schema=public"

# --- Redis ---
# BullMQ uses DB 0, sessions use DB 1 (see modules/queue and main.ts session setup).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_DB=0
REDIS_SESSION_DB=1

# --- Sessions ---
# Long random string used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-64-char-hex-string
SESSION_COOKIE_NAME=content_hub_sid
# 12 hours, sliding, in milliseconds
SESSION_TTL_MS=43200000

# --- Token encryption (AES-256-GCM) ---
# Exactly 32 bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# --- Facebook OAuth (Meta Graph API) ---
FACEBOOK_APP_ID=replace-with-meta-app-id
FACEBOOK_APP_SECRET=replace-with-meta-app-secret
# Must exactly match a redirect URI registered in the Meta App dashboard.
FACEBOOK_REDIRECT_URI=http://localhost:4000/api/connected-accounts/facebook/callback
FACEBOOK_GRAPH_API_VERSION=v21.0
FACEBOOK_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts

# --- Google OAuth (YouTube Data API) ---
# Optional: leave blank until you have Google Cloud OAuth credentials —
# the app boots fine without them; the YouTube connect flow just returns a
# clear "not configured" error until they are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in the Google Cloud console.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/connected-accounts/google/callback
# Space-separated (Google convention), unlike Meta's comma-separated scopes.
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly

# --- Publisher safety flags ---
# MUST stay "mock" everywhere except an explicit production opt-in; the app
# REFUSES TO BOOT with a non-mock value while NODE_ENV != production (see
# assertPublisherFlagsAreSafe in src/main.ts). In mock mode publish jobs
# run the full orchestration but make no network calls (dry-run external
# ids like "dry-run-facebook-<postId>").
PUBLISHER_IMPL_FACEBOOK=mock
PUBLISHER_IMPL_YOUTUBE=mock
# Phase 5. TikTok/LINE OA are delivered as mock adapters + the manual-external
# -record path (POST /api/posts/manual-external): the admin publishes natively
# on the platform, then records the external id + URL here. Their live paths
# are structured stubs that have NEVER been verified against a real API — no
# credentials exist (TikTok needs an audited app; LINE is broadcast, not feed).
PUBLISHER_IMPL_TIKTOK=mock
PUBLISHER_IMPL_LINE=mock
MOCK_PUBLISHER_LATENCY_MS=50
MOCK_PUBLISHER_FAILURE_RATE=0

# --- Ranking engine ---
# v1 = the frozen 4-factor engine over Facebook/YouTube.
# v2 = 5 factors (revenue-blended engagement + override_feedback) over all four
# platforms. Defaults to v1; flip to v2 only after QA verifies it.
RANKING_ENGINE=v2

# --- Uploads ---
UPLOAD_STORAGE_DIR=./storage/uploads
UPLOAD_MAX_IMAGE_BYTES=20971520
UPLOAD_MAX_VIDEO_BYTES=524288000

# --- Seed script ---
# If unset, the seed script generates a random password and prints it once —
# it is never hardcoded or committed. See prisma/seed.ts.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Content Hub Admin
SEED_ADMIN_PASSWORD=
